      "binary": {
        "type": "binary",
        "executable_name": "rolefit-engine",
        "supports_protocol": true,
        "binary_artifacts": {
          "linux-x86_64": { "path": "dist/rolefit-engine-posix.tar.gz", "entrypoint": "bin/rolefit-engine" },
          "linux-arm64": { "path": "dist/rolefit-engine-posix.tar.gz", "entrypoint": "bin/rolefit-engine" },
          "darwin-arm64": { "path": "dist/rolefit-engine-posix.tar.gz", "entrypoint": "bin/rolefit-engine" },
          "darwin-x86_64": { "path": "dist/rolefit-engine-posix.tar.gz", "entrypoint": "bin/rolefit-engine" },
          "windows-x86_64": { "path": "dist/rolefit-engine-win.zip", "entrypoint": "bin/rolefit-engine.cmd" },
          "windows-arm64": { "path": "dist/rolefit-engine-win.zip", "entrypoint": "bin/rolefit-engine.cmd" }
        }
      },
      "local": {
        "type": "local",
        "executable_name": "rolefit-engine"
      }
    }
  }
}
