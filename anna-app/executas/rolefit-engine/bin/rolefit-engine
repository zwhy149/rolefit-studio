#!/bin/sh
set -eu
NODE_BIN="${ANNA_NODE_EXECUTABLE:-$(command -v node || true)}"
if [ -z "$NODE_BIN" ]; then
  for candidate in /usr/local/bin/node /usr/bin/node /data/.anna/runtimes/node/current/bin/node /home/agent/.local/bin/node /home/agent/.local/share/fnm/aliases/default/bin/node; do
    if [ -x "$candidate" ]; then
      NODE_BIN="$candidate"
      break
    fi
  done
fi
: "${NODE_BIN:?Node.js >= 20 is required to run rolefit-engine.}"
SCRIPT_DIR="${EXECUTA_HOME:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
exec "$NODE_BIN" "$SCRIPT_DIR/rolefit_engine_plugin.js" "$@"
